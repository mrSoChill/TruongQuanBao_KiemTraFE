                        <span class="badge blue">CHÍNH HÃNG</span>
                        <span class="brand">Thương hiệu: <b>Glucerna</b></span>
                    </div>
                    <h1>Lon Sữa Glucerna 800g/lon - Tặng 2 gói dùng thử</h1>
                    <div class="rating-line"><b>5.0</b> <span class="stars">★★★★★</span> <span class="muted">(11)</span> <span class="divider">|</span> <span class="muted">Đã bán 436</span></div>
                    <div class="made-in">Made in Spain</div>
                    <div class="product-price">1.034.550<sup>đ</sup></div>
                    <div class="flavor-title">Hương vị</div>
                    <button class="flavor active" type="button">Vani</button>
                </div>

                <div class="card shipping-card">
                    <div class="section-row"><b>Thông tin vận chuyển</b></div>
                    <div class="section-row address-row"><span>Giao đến Q.1, P. Bến Nghé, Hồ Chí Minh</span><a href="#">Đổi</a></div>
                    <div class="ship-option">
                        <div><span class="now">NOW</span> <b>Giao siêu tốc 2h</b></div>
                        <div class="ship-sub">Trước Thứ hôm nay: <b>Miễn phí</b> <s>25.000đ</s></div>
                    </div>
                    <div class="ship-option">
                        <div><i class="fas fa-truck fast-icon"></i> <b>Giao đúng sáng mai</b></div>
                        <div class="ship-sub">8h - 12h, 01/10: <b>Miễn phí</b> <s>18.000đ</s></div>
                    </div>
                    <div class="freeship-note"><i class="fas fa-truck"></i> Freeship 10k đơn từ 45k, Freeship 25k đơn từ 100k <i class="far fa-question-circle"></i></div>
                </div>

                <div class="card extra-card">
                    <b>Dịch vụ bổ sung</b>
                    <div class="extra-row"><span class="mini-icon blue-round"><i class="fas fa-credit-card"></i></span><span>Ưu đãi đến 600k với thẻ TikiCard</span><a href="#">Đăng ký</a></div>
                    <div class="extra-row"><span class="mini-icon purple-round"><i class="fas fa-wallet"></i></span><span>Mua trước trả sau</span><a href="#">Đăng ký</a></div>
                </div>
            </section>

            <aside class="buy-column">
                <div class="card seller-card">
                    <div class="seller-head">
                        <div><span class="mini-tiki">TIKI</span> <b>Tiki Trading</b><div><span class="official">OFFICIAL</span> <span class="seller-rating">4.7 ★</span> <span class="muted">(5,5tr+ đánh giá)</span></div></div>
                        <button class="icon-button" aria-label="Tìm kiếm"><i class="fas fa-search"></i></button>
                    </div>
                    <div class="selected-flavor"><img src="~/images/glucerna-product-left.png" alt="Vani" /><span>Vani</span></div>
                    <hr />
                    <label class="quantity-label" for="quantity">Số Lượng</label>
                    <div class="quantity-control">
                        <button id="minusBtn" type="button" aria-label="Giảm số lượng">−</button>
                        <input id="quantity" type="number" min="1" max="99" value="1" />
                        <button id="plusBtn" type="button" aria-label="Tăng số lượng">+</button>
                    </div>
                    <div class="subtotal-label">Tạm tính</div>
                    <div id="subtotal" class="subtotal" data-price="1034550">1.034.550<sup>đ</sup></div>
                    <button class="buy-now" type="button">Mua ngay</button>
                    <button class="outline-action" type="button">Thêm vào giỏ</button>
                    <button class="outline-action" type="button">Mua trước trả sau</button>
                </div>

            </aside>
        </div>
    </div>
</main>
