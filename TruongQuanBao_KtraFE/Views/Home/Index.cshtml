            <small>Tốt &amp; Nhanh</small>
        </a>

        <div class="search-area">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" value="Freeship đơn từ 45k" aria-label="Tìm kiếm" />
