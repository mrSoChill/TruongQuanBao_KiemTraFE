            <div class="quick-keywords">
                <span>điện gia dụng</span><span>xe cộ</span><span>mẹ &amp; bé</span><span>khỏe đẹp</span>
                <span>nhà cửa</span><span>sách</span><span>thể thao</span><span>ensure</span><span>ensure gold</span>
            </div>
        </div>

        <div class="header-actions">
            <a href="#"><i class="fas fa-home"></i> Trang chủ</a>
            <a href="#"><i class="far fa-user"></i> Tài khoản</a>
            <a class="cart-link" href="#"><i class="fas fa-shopping-cart"></i><b>0</b></a>
            <div class="delivery"><i class="fas fa-map-marker-alt"></i> Giao đến: <u>Q.1, P. Bến Nghé, Hồ Chí Minh</u></div>
        </div>
    </div>

    <div class="service-strip">
        <div class="page-shell strip-content">
            <span><i class="fas fa-shield-alt"></i> Cam kết</span>
            <span><i class="fas fa-check-circle"></i> 100% hàng thật</span>
            <span><i class="fas fa-sync-alt"></i> Hoàn 200% nếu hàng giả</span>
            <span><i class="fas fa-calendar-check"></i> 30 ngày đổi trả</span>
            <span><i class="fas fa-truck"></i> Giao nhanh 2h</span>
            <span><i class="fas fa-tag"></i> Giá siêu rẻ</span>
            <span><i class="fas fa-box-open"></i> Freeship mọi đơn</span>
        </div>
    </div>
</header>

<main class="page-bg">
