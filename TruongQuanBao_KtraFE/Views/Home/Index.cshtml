        <div class="product-grid">
            <section class="gallery card">
                <div class="main-image-wrap">
                    <img id="mainProductImage" src="~/images/glucerna-product-all.png" alt="Bộ sản phẩm Glucerna 800g" />
                </div>
                <div class="thumb-list">
                    <button type="button" class="thumb active" data-img="/images/glucerna-product-all.png" aria-label="Ảnh sản phẩm tổng thể">
                        <img src="~/images/glucerna-product-all.png" alt="Bộ sản phẩm Glucerna" />
                    </button>
                    <button type="button" class="thumb" data-img="/images/glucerna-product-left.png" aria-label="Ảnh mặt bên trái">
                        <img src="~/images/glucerna-product-left.png" alt="Glucerna mặt bên trái" />
                    </button>
                    <button type="button" class="thumb" data-img="/images/glucerna-product-right.png" aria-label="Ảnh mặt bên phải">
                        <img src="~/images/glucerna-product-right.png" alt="Glucerna mặt bên phải" />
